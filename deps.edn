{:paths ["src" "resources"]
 :deps {org.clojure/clojure           {:mvn/version "1.12.3"}
        http-kit/http-kit             {:mvn/version "2.8.1"}
        metosin/reitit                {:mvn/version "0.10.0"}
        ring/ring-core                {:mvn/version "1.15.3"}
        hiccup/hiccup                 {:mvn/version "2.0.0"}
        aero/aero                     {:mvn/version "1.1.6"}
        integrant/integrant           {:mvn/version "1.0.1"}
        org.replikativ/datahike       {:mvn/version "0.7.1663"}
        ramblurr/datahike-sqlite      {:git/url "https://github.com/ramblurr/datahike-sqlite"
                                       :git/sha "57aea272dab21d5e8a286994f70936fe963e8652"}
        buddy/buddy-hashers           {:mvn/version "2.0.167"}
        org.suskalo/coffi             {:mvn/version "1.0.615"}
        com.brunobonacci/mulog        {:mvn/version "0.10.1"}}
 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps  {integrant/repl              {:mvn/version "0.5.1"}
                      io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                      com.nextjournal/beholder    {:mvn/version "1.0.2"}}
        :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}
  :watch
  {:extra-paths ["dev"]
   :extra-deps  {integrant/repl              {:mvn/version "0.5.1"}
                 io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                 com.nextjournal/beholder    {:mvn/version "1.0.2"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
   :exec-fn     rowmania.dev/watch!}
  :cli
  {:main-opts ["-m" "rowmania.cli"]
   :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}
  :start-server
  {:exec-fn  rowmania.core/main-
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :test
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
   :exec-fn     rowmania.test-runner/run}}}
